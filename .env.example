# Settings for local development. Copy this file to ".env".
# On Vercel, set these in Project -> Settings -> Environment Variables
# (DATABASE_URL and BLOB_STORE_ID are added for you when you connect the
# Neon database and Blob store).
# Never share or commit the real .env file.

# ---------- Sign-in (Clerk: email codes, Google, forgot password) ----------
# dashboard.clerk.com -> your app -> API keys.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# The owner: whoever signs in with this email is an admin (and can't be removed).
ADMIN_EMAIL=you@example.com

# ---------- AI names and alt text (Pro) ----------
# Free key from aistudio.google.com -> Get API key.
GEMINI_API_KEY=
# Optional: GEMINI_MODEL (default gemini-flash-latest), AI_DAILY_LIMIT (200 images per user per day)

# ---------- Leave empty locally ----------
# Empty = built-in local database in data/pglite.
DATABASE_URL=
# Empty = files saved in data/blobs. (On Vercel, BLOB_STORE_ID is set
# automatically; a BLOB_READ_WRITE_TOKEN works too.)
BLOB_STORE_ID=
# Empty = random key saved in data/.secret. REQUIRED on Vercel (long random string).
SESSION_SECRET=
# Protects the daily cleanup job. Recommended on Vercel (long random string).
CRON_SECRET=

# ---------- Email (Pro expiry reminders) ----------
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it below.
# Without these, local development prints the emails in the terminal.
SMTP_USER=
SMTP_PASS=
# Optional: SMTP_HOST (default smtp.gmail.com), SMTP_PORT (465), MAIL_FROM

# ---------- PayPal (sandbox = test payments, no real money) ----------
# From developer.paypal.com -> Apps & Credentials -> Sandbox -> your app.
# PayPal doesn't accept LKR: use USD (or another PayPal currency) in admin Settings.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true

# ---------- PayHere (optional; needs your own root domain, not *.vercel.app) ----------
# From sandbox.payhere.lk -> Settings -> Domains & Credentials.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
# Your public address. On Vercel the production domain is used automatically.
PUBLIC_URL=

# Local server port
PORT=3001
